# Simulation container for TrackVLA ROS 2.
#
# Deliberately separate from the inference image. The two share a DDS domain
# through host networking, so separation costs nothing at runtime, while
# sharing would mean rebuilding a 33 GB CUDA image every time a world file
# changes, and would contradict docs/environment.md, which excludes simulation
# from the inference image.
#
# Gazebo comes from the ROS apt repository as vendor packages, not from
# packages.osrfoundation.org. ros-jazzy-gz-sim-vendor bundles gz-sim8, which
# is Harmonic, the LTS paired with Jazzy. Adding the OSRF repository as well
# would put two Gazebo sources on the system and invite a version conflict.
FROM ros:jazzy-ros-base

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USER_NAME=developer

ENV PYTHONUNBUFFERED=1 \
    ROS_DISTRO=jazzy \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-gz \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-ros-gz-sim \
    ros-jazzy-cv-bridge \
    && rm -rf /var/lib/apt/lists/*

# Writing the third-person video headlessly. python3-opencv comes from apt so
# it stays the same build cv_bridge links against.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3-opencv \
    sudo \
    vim \
    && rm -rf /var/lib/apt/lists/*

# A display of the container's own. Xvnc is a full X server rather than a
# screen-sharing tool: it creates a display that exists only in memory, with
# no physical screen and no connection to the host's desktop.
#
# That isolation is the point. Running the Gazebo GUI against the host's
# session crashed GNOME Shell itself, taking the whole remote desktop with it
# every time, so it could not be experimented with. A crash here costs only
# this X server.
#
# openbox gives windows a title bar so they can be moved and resized, and
# xterm gives somewhere to type inside the session. x11vnc is installed only
# for its -storepasswd: this build of tigervnc ships no vncpasswd, and macOS
# Screen Sharing refuses a server that offers no authentication.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tigervnc-standalone-server \
    tigervnc-common \
    x11vnc \
    openbox \
    xterm \
    x11-utils \
    && rm -rf /var/lib/apt/lists/*

RUN if getent passwd "${USER_ID}" >/dev/null; then \
        userdel -r "$(getent passwd "${USER_ID}" | cut -d: -f1)" || true; \
    fi \
    && if ! getent group "${GROUP_ID}" >/dev/null; then \
        groupadd --gid "${GROUP_ID}" "${USER_NAME}"; \
    fi \
    && useradd --uid "${USER_ID}" --gid "${GROUP_ID}" --create-home \
       --shell /bin/bash "${USER_NAME}" \
    && echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USER_NAME} \
    && chmod 0440 /etc/sudoers.d/${USER_NAME}

RUN mkdir -p /workspace/trackvla_ros2 \
    && chown -R "${USER_ID}:${GROUP_ID}" /workspace

COPY docker/entrypoint-gazebo.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER ${USER_NAME}
WORKDIR /workspace/trackvla_ros2

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
