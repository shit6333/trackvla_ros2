<?xml version="1.0" ?>
<sdf version="1.5">
    <model name="turtlebot3_burger">
        <link name="base">
            <inertial>
                <pose>-0.032 0 0.070 0 0 0</pose>
                <inertia>
                    <ixx>0.001</ixx>
                    <ixy>0.000</ixy>
                    <ixz>0.000</ixz>
                    <iyy>0.001</iyy>
                    <iyz>0.000</iyz>
                    <izz>0.001</izz>
                </inertia>
                <mass>1.0</mass>
            </inertial>
            <collision name="base_collision">
                <pose>-0.032 0 0.070 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.140 0.140 0.140</size>
                    </box>
                </geometry>
            </collision>
            <visual name="base_visual">
                <pose>-0.032 0 0 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>meshes/burger_base.stl</uri>
                        <scale>.001 .001 .001</scale>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.9 0.1 0 1</ambient>
                    <diffuse>0.9 0.1 0 1</diffuse>
                    <specular>0.9 0.2 0.2 1</specular>
                    <emissive>0.9 0 0.1 1</emissive>
                </material>
            </visual>
            <collision name="caster_collision">
                <pose>-0.081 0 -0.004 0 0 0</pose>
                <geometry>
                    <sphere>
                        <radius>0.005000</radius>
                    </sphere>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.01</mu>
                            <mu2>0.01</mu2>
                            <fdir1>0 0 0</fdir1>
                            <slip1>0</slip1>
                            <slip2>0</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <!-- The model's input, matched to what the checkpoint was trained
                 on rather than to this chassis.

                 Resolution. OmTrackVLA's episodes come from a Spot jaw camera
                 configured 384x384 at 90 degrees hfov, and the encoder resizes
                 every frame to a 384 square with force_square_resize and no
                 letterbox (cache_gridpool.py:253). A 640x480 frame therefore
                 arrives compressed 4:3 horizontally and every person in it is
                 a third too narrow.

                 Height. That jaw camera sits 0.24 m above a Spot's body,
                 roughly 0.6 to 0.75 m off the floor. At 0.18 m, where a
                 Burger's own deck would put it, the view looks up at people
                 from ankle height and matches nothing in the training set.
                 Ground is at z = -0.010 in these coordinates, so 0.63 is
                 0.64 m up. That is a mast, and real hardware would need one
                 too. A sensor carries no mass, so the tipping margin derived
                 in velocity_smoother.yaml is unaffected. A visual mast was
                 tried here and removed: it looked like the cause of some
                 tip-overs, but a <visual> carries no collision and no
                 inertia, so it cannot have been. The camera is simply
                 mounted on the mast below, which is a <visual>: no collision,
                 no inertia, nothing the solver sees. It cannot affect
                 stability, and neither can the sensor, which is massless
                 too. Tip-overs in this world come from the manoeuvring the
                 tracker does around people, not from anything up here. -->
            <visual name="camera_mast">
                <pose>0.03 0 0.31 0 0 0</pose>
                <geometry>
                    <cylinder><radius>0.012</radius><length>0.64</length></cylinder>
                </geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient>
                    <diffuse>0.25 0.25 0.25 1</diffuse>
                </material>
            </visual>
            <sensor name="front_camera" type="camera">
                <!-- <pose>x y z roll pitch yaw</pose> -->
                <pose>0.05 0 0.63 0 0 0</pose>
                <camera>
                    <horizontal_fov>1.5708</horizontal_fov>
                    <image><width>384</width><height>384</height><format>R8G8B8</format></image>
                    <clip><near>0.05</near><far>50</far></clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>false</visualize>
                <topic>/tb_front_camera</topic>
            </sensor>
        </link>
        <link name="lidar">
            <inertial>
                <pose>-0.020 0 0.161 0 0 0</pose>
                <inertia>
                    <ixx>0.001</ixx>
                    <ixy>0.000</ixy>
                    <ixz>0.000</ixz>
                    <iyy>0.001</iyy>
                    <iyz>0.000</iyz>
                    <izz>0.001</izz>
                </inertia>
                <mass>0.125</mass>
            </inertial>
            <collision name="lidar_sensor_collision">
                <pose>-0.020 0 0.161 0 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0508</radius>
                        <length>0.055</length>
                    </cylinder>
                </geometry>
            </collision>
            <visual name="lidar_sensor_visual">
                <pose>-0.032 0 0.171 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>meshes/lds.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.5 0.75 0 1</ambient>
                    <diffuse>0.7 0.9 0 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                    <emissive>0.1 0 0.1 1</emissive>
                </material>
            </visual>
            <sensor name="hls_lfcd_lds" type="gpu_ray">
                <always_on>1</always_on>
                <visualize>0</visualize>
                <pose>-0.032 0 0.171 0 0 0</pose>
                <update_rate>1800</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1.000000</resolution>
                            <min_angle>0.000000</min_angle>
                            <max_angle>6.280000</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.120000</min>
                        <max>3.5</max>
                        <resolution>0.015000</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>
            </sensor>
        </link>
        <link name="left_wheel">
            <inertial>
                <pose>0 0.08 0.023 -1.57 0 0</pose>
                <inertia>
                    <ixx>0.001</ixx>
                    <ixy>0.000</ixy>
                    <ixz>0.000</ixz>
                    <iyy>0.001</iyy>
                    <iyz>0.000</iyz>
                    <izz>0.001</izz>
                </inertia>
                <mass>0.1</mass>
            </inertial>
            <collision name="left_wheel_collision">
                <pose>0 0.08 0.023 -1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.033</radius>
                        <length>0.018</length>
                    </cylinder>
                </geometry>
                <surface>
                    <!-- This friction pamareter don't contain reliable data!! -->
                    <friction>
                        <ode>
                            <mu>100000.0</mu>
                            <mu2>100000.0</mu2>
                            <fdir1>0 0 0</fdir1>
                            <slip1>0.0</slip1>
                            <slip2>0.0</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="left_wheel_visual">
                <pose>0 0.08 0.023 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>meshes/left_tire.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.1 0.1 0.1 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                    <emissive>0.1 0.1 0.1 1</emissive>
                </material>
            </visual>
        </link>
        <link name="right_wheel">
            <inertial>
                <pose>0.0 -0.08 0.023 -1.57 0 0</pose>
                <inertia>
                    <ixx>0.001</ixx>
                    <ixy>0.000</ixy>
                    <ixz>0.000</ixz>
                    <iyy>0.001</iyy>
                    <iyz>0.000</iyz>
                    <izz>0.001</izz>
                </inertia>
                <mass>0.1</mass>
            </inertial>
            <collision name="right_wheel_collision">
                <pose>0.0 -0.08 0.023 -1.57 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.033</radius>
                        <length>0.018</length>
                    </cylinder>
                </geometry>
                <surface>
                    <!-- This friction pamareter don't contain reliable data!! -->
                    <friction>
                        <ode>
                            <mu>100000.0</mu>
                            <mu2>100000.0</mu2>
                            <fdir1>0 0 0</fdir1>
                            <slip1>0.0</slip1>
                            <slip2>0.0</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="right_wheel_visual">
                <pose>0.0 -0.08 0.023 0 0 0</pose>
                <geometry>
                    <mesh>
                        <uri>meshes/right_tire.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.1 0.1 0.1 1</ambient>
                    <diffuse>0.1 0.1 0.1 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                    <emissive>0.1 0.1 0.1 1</emissive>
                </material>
            </visual>
        </link>
        <joint name="left_wheel_joint" type="revolute">
            <parent>base</parent>
            <child>left_wheel</child>
            <pose>0.0 0.08 0.023 -1.57 0 0</pose>
            <axis>
                <xyz>0 0 1</xyz>
            </axis>
        </joint>
        <joint name="right_wheel_joint" type="revolute">
            <parent>base</parent>
            <child>right_wheel</child>
            <pose>0.0 -0.08 0.023 -1.57 0 0</pose>
            <axis>
                <xyz>0 0 1</xyz>
            </axis>
        </joint>
        <joint name="lidar_joint" type="fixed">
            <parent>base</parent>
            <child>lidar</child>
            <pose>-0.032 0 0.171 0 0 0</pose>
            <axis>
                <xyz>0 0 1</xyz>
                <use_parent_model_frame>true</use_parent_model_frame>
            </axis>
        </joint>
        <!-- 第三人稱視角，剛性固定在車體後上方。錄影用，模型看不到它。 -->
        <link name="chase_camera_link">
            <pose>-1.8 0 1.2 0 0.28 0</pose>
            <inertial>
                <mass>0.01</mass>
                <inertia>
                    <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
                    <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
                </inertia>
            </inertial>
            <sensor name="chase_camera" type="camera">
                <camera>
                    <horizontal_fov>1.4</horizontal_fov>
                    <image><width>960</width><height>540</height><format>R8G8B8</format></image>
                    <clip><near>0.1</near><far>100</far></clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <visualize>false</visualize>
                <topic>/tb_chase_camera</topic>
            </sensor>
        </link>
        <joint name="chase_camera_joint" type="fixed">
            <parent>base</parent>
            <child>chase_camera_link</child>
        </joint>

        <!-- DIFF DRIVE PLUGIN / WHEELS CONTROLER -->
        <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.16</wheel_separation>
            <wheel_radius>0.033</wheel_radius>
            <odom_publish_frequency>20</odom_publish_frequency>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <!-- 底盤能力上限。真實 Burger 是 0.22 m/s / 2.84 rad/s；
                 這裡放寬到 1.2，因為場景裡的行人走 0.4 m/s，追不上就看不到模型的意圖。 -->
            <max_linear_velocity>1.2</max_linear_velocity>
            <max_angular_velocity>3.0</max_angular_velocity>
        </plugin>
        <!-- Gazebo 的真值位姿。DiffDrive 的 /odometry 是積分輪子轉動得來的，
             轉彎會累積誤差（test_robot 量過幾分鐘漂移 3.2 m）。這個沒有誤差，
             但真機上不存在，只給視覺化用。 -->
        <plugin filename="gz-sim-pose-publisher-system"
                name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <publish_model_pose>true</publish_model_pose>
            <publish_nested_model_pose>false</publish_nested_model_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>false</static_publisher>
            <update_frequency>30</update_frequency>
        </plugin>
        <static>0</static>
    </model>
</sdf>
