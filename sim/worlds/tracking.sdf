<?xml version="1.0"?>
<!--
  Minimal world for validating the ROS pipeline end to end.

  It is deliberately plain. What is being tested here is whether images reach
  the model, whether commands reach the wheels, and whether the safety paths
  behave; not whether the checkpoint can track anything. The appearance gap
  between this world and the photorealistic scans the model was trained on is
  large and is a separate problem.
-->
<sdf version="1.9">
  <world name="tracking">

    <!-- Real time factor is pinned to 1.0 on purpose. The runtime nodes time
         their plans with time.monotonic() while their publishing timers run
         on the ROS clock, so the two only agree while simulation time tracks
         wall time. Running faster than real time requires converting both
         nodes to the ROS clock first. See D021. -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.1 0.1 0.12 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>


    <!-- Something to look at, so the recorded video shows whether the robot
         is actually moving relative to the world rather than shaking in
         place. -->
    <!-- Landmark posts on a 4 m grid.
         The chase camera is rigidly attached to the robot, so the robot never
         moves within its own frame; the only cue that anything is happening
         is the background. Against a bare ground plane there is none, and a
         recording of a robot creeping at 0.04 m/s looks identical to a
         recording of a robot standing still. These give the eye something to
         measure against. They are static and thin, so they cost almost
         nothing to simulate. -->

    <!-- People rather than boxes.
         The checkpoint was trained to follow humanoids, so a scene made of
         coloured boxes is further out of distribution than it needs to be.
         These are the stock Gazebo actors, fetched from Fuel on first use and
         cached under cache/gz by the compose mount, so a run after the first
         one needs no network.

         An actor without a <skin> renders nothing at all and only logs a
         warning, which is how an earlier version of this world ended up with
         an invisible target. Each actor below therefore names its mesh
         explicitly, and <animation> repeats it so the skeleton has something
         to play. -->

    <!-- The target. Walks a 4 m by 4 m loop at 0.4 m/s, slower than the
         robot's 0.5 m/s full speed so that following it is achievable rather
         than a race the robot cannot win. Each corner holds position for a
         second while the yaw changes, which is what keeps the walk animation
         pointing along the direction of travel. -->
    <!-- The posts are a 4 m grid with two omitted. post_2_2 at (4, 0) sat
         exactly on the line from the robot's spawn to the green walker's
         start, hiding the target in the first frames of every run, and
         post_3_2 at (8, 0) stood on two of the three walking circles, which
         actors pass straight through because they have no collision. Both
         were artefacts of a grid laid out before the walkers existed. See
         sim/scripts/actor_paths.py for the geometry they clashed with. -->
    <!-- A room, because the checkpoint has never seen anything else. Its
         episodes are HSSD interiors: floors, walls, furniture, bounded space.
         The grey infinite plane under a blue sky that this world used to be is
         not a hard scene for the tracker, it is a scene the vision encoders
         were never trained to describe, and no amount of prompt wording fixes
         that.

         9.76 x 9.76 m and 3.05 m high, centred here at (2, 0) so the robot
         spawn at the origin keeps 2.9 m to the wall behind it and the walking
         circles keep 2.3 m to the wall ahead. It carries its own floor, its own
         collision, and a baked lightmap, which is why the ground plane and the
         27 landmark posts are gone: the posts existed to give the camera
         something to parallax against, and a textured room does that far
         better. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Indoor lightmap</uri>
      <name>room</name>
      <!-- The 0.668 lift is measured, not chosen. The mesh carries a node
           transform that puts its floor that far below the model origin, so
           included at z = 0 the whole room sinks and everything placed at
           z = 0 by this world (the walkers, the robot spawn) ends up in
           mid air above it. Reading the COLLADA position arrays alone misses
           this; what settled it was dropping the robot in and watching where
           it came to rest (z = -0.658, with its base 0.010 above the floor). -->
      <pose>2 0 0.668 0 0 0</pose>
    </include>

    <!-- One target on a loop and two distractors crossing it,
         generated by sim/scripts/actor_paths.py. Edit the paths
         there and re-emit; the same module answers position_at()
         for an evaluator, so the world and the measurement cannot
         drift apart. -->
    <actor name="person_green_shirt">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="1.0">
          <waypoint><time>0.00</time><pose>2.5000 0.0000 1 0 0 1.5708</pose></waypoint>
          <waypoint><time>3.00</time><pose>2.5000 0.0000 1 0 0 1.5708</pose></waypoint>
          <waypoint><time>6.85</time><pose>2.5000 1.5000 1 0 0 1.5708</pose></waypoint>
          <waypoint><time>7.85</time><pose>2.5000 1.5000 1 0 0 0.0000</pose></waypoint>
          <waypoint><time>12.97</time><pose>4.5000 1.5000 1 0 0 0.0000</pose></waypoint>
          <waypoint><time>13.97</time><pose>4.5000 1.5000 1 0 0 -1.5708</pose></waypoint>
          <waypoint><time>21.67</time><pose>4.5000 -1.5000 1 0 0 -1.5708</pose></waypoint>
          <waypoint><time>22.67</time><pose>4.5000 -1.5000 1 0 0 -3.1416</pose></waypoint>
          <waypoint><time>27.79</time><pose>2.5000 -1.5000 1 0 0 -3.1416</pose></waypoint>
          <waypoint><time>28.79</time><pose>2.5000 -1.5000 1 0 0 1.5708</pose></waypoint>
          <waypoint><time>32.64</time><pose>2.5000 0.0000 1 0 0 1.5708</pose></waypoint>
          <waypoint><time>33.64</time><pose>2.5000 0.0000 1 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="person_spiderman">
      <skin>
        <filename>/workspace/trackvla_ros2/cache/spiderman_scaled/meshes/model.obj</filename>
        <scale>1.0</scale>
      </skin>
      <!-- No animation data in this mesh: the figure holds its pose and slides. -->
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="1.0">
          <waypoint><time>0.00</time><pose>4.0000 1.6000 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>9.00</time><pose>4.0000 1.6000 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>17.21</time><pose>4.0000 -1.6000 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>18.21</time><pose>4.0000 -1.6000 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>26.41</time><pose>4.0000 1.6000 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>27.41</time><pose>4.0000 1.6000 0 0 0 -1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="person_white_shirt">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/abmohit/models/walking person/1/files/meshes/walking.dae</filename>
        <scale>1.0</scale>
      </skin>
      <!-- No animation data in this mesh: the figure holds its pose and slides. -->
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="1.0">
          <waypoint><time>0.00</time><pose>3.0000 -1.9000 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>6.00</time><pose>3.0000 -1.9000 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>11.64</time><pose>5.2000 -1.9000 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>12.64</time><pose>5.2000 -1.9000 0 0 0 -3.1416</pose></waypoint>
          <waypoint><time>19.05</time><pose>5.2000 0.6000 0 0 0 -3.1416</pose></waypoint>
          <waypoint><time>20.05</time><pose>5.2000 0.6000 0 0 0 0.0000</pose></waypoint>
          <waypoint><time>26.46</time><pose>5.2000 -1.9000 0 0 0 0.0000</pose></waypoint>
          <waypoint><time>27.46</time><pose>5.2000 -1.9000 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>33.10</time><pose>3.0000 -1.9000 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>34.10</time><pose>3.0000 -1.9000 0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- One person, deliberately. Distractors belong to a later experiment;
         while the question is whether the robot can follow anything at all,
         a second identical figure only makes a failure harder to read. -->

    <!-- test_robot is out of the world while the TurtleBot is the subject.
         Putting it back means uncommenting this and switching the bridge to
         sim/config/bridge_test_robot.yaml; the two are wired identically and
         differ only in five topic names. Two robots in one scene would also
         put a robot in the other's camera, which the model has no reason to
         handle well. -->
    <!-- <include>
      <uri>model://test_robot</uri>
      <pose>0 0 0.1 0 0 0</pose>
    </include> -->

    <include>
      <uri>model://turtlebot3_burger</uri>
      <!-- 生成位置由相機視野決定，不是隨便放的。水平 FOV 90 度（±45），
           行人的起點在 (3,-2)：
             從 (2,2) 朝 +x  ->  方位 -76 度，在畫面外，模型看不到人
             從 (0,0) 朝 +x  ->  方位 -34 度，在畫面內
           base 原點離地 0.010 m，所以 z 用 0.02 就好，不需要摔下來。 -->
      <pose>0 0 0.02 0 0 0</pose>
    </include>

  </world>
</sdf>
