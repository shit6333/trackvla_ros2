<?xml version="1.0"?>
<!--
  Minimal world for validating the ROS pipeline end to end.

  It is deliberately plain. What is being tested here is whether images reach
  the model, whether commands reach the wheels, and whether the safety paths
  behave; not whether the checkpoint can track anything. The appearance gap
  between this world and the photorealistic scans the model was trained on is
  large and is a separate problem.
-->
<sdf version="1.9">
  <world name="tracking">

    <!-- Real time factor is pinned to 1.0 on purpose. The runtime nodes time
         their plans with time.monotonic() while their publishing timers run
         on the ROS clock, so the two only agree while simulation time tracks
         wall time. Running faster than real time requires converting both
         nodes to the ROS clock first. See D021. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.5 0.65 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Something to look at, so the recorded video shows whether the robot
         is actually moving relative to the world rather than shaking in
         place. -->
    <model name="marker_a">
      <static>true</static>
      <pose>4 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.8 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="marker_b">
      <static>true</static>
      <pose>4 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 1.0</size></box></geometry>
          <material><ambient>0.1 0.4 0.1 1</ambient><diffuse>0.15 0.6 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A target that moves on a fixed path.
         Implemented as a model driven at constant velocity rather than as an
         SDF actor. An actor needs a skin mesh, and without one Gazebo logs
         "Actor skin mesh not found" and renders nothing at all, which is how
         the first version of this world ended up with an invisible target.
         A constant linear and angular velocity gives a repeatable circle with
         no mesh and no external commands. -->
    <model name="target">
      <pose>3 0 0.5 0 0 0</pose>
      <link name="link">
        <!-- Gravity is off. With it on, the commanded velocity toppled this
             tall thin box within a second or two; once toppled its local
             forward axis pointed into the ground and it stopped moving, which
             is how the target ended up both fallen over and stationary. It is
             a visual reference, not a physics subject, so floating it is the
             honest simplification. -->
        <gravity>false</gravity>
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>1.0</ixx><iyy>1.0</iyy><izz>0.3</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material>
            <ambient>0.7 0.4 0.05 1</ambient>
            <diffuse>0.95 0.6 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- 0.3 m/s around a 2 m circle, slow enough for the robot to follow. -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
        <initial_linear>0.3 0 0</initial_linear>
        <initial_angular>0 0 0.15</initial_angular>
      </plugin>
    </model>

    <include>
      <uri>model://test_robot</uri>
      <pose>0 0 0.1 0 0 0</pose>
    </include>

  </world>
</sdf>
