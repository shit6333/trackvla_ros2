<?xml version="1.0"?>
<!--
  Minimal world for validating the ROS pipeline end to end.

  It is deliberately plain. What is being tested here is whether images reach
  the model, whether commands reach the wheels, and whether the safety paths
  behave; not whether the checkpoint can track anything. The appearance gap
  between this world and the photorealistic scans the model was trained on is
  large and is a separate problem.
-->
<sdf version="1.9">
  <world name="tracking">

    <!-- Real time factor is pinned to 1.0 on purpose. The runtime nodes time
         their plans with time.monotonic() while their publishing timers run
         on the ROS clock, so the two only agree while simulation time tracks
         wall time. Running faster than real time requires converting both
         nodes to the ROS clock first. See D021. -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.5 0.65 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Something to look at, so the recorded video shows whether the robot
         is actually moving relative to the world rather than shaking in
         place. -->
    <!-- People rather than boxes.
         The checkpoint was trained to follow humanoids, so a scene made of
         coloured boxes is further out of distribution than it needs to be.
         These are the stock Gazebo actors, fetched from Fuel on first use and
         cached under cache/gz by the compose mount, so a run after the first
         one needs no network.

         An actor without a <skin> renders nothing at all and only logs a
         warning, which is how an earlier version of this world ended up with
         an invisible target. Each actor below therefore names its mesh
         explicitly, and <animation> repeats it so the skeleton has something
         to play. -->

    <!-- The target. Walks a 4 m by 4 m loop at 0.4 m/s, slower than the
         robot's 0.5 m/s full speed so that following it is achievable rather
         than a race the robot cannot win. Each corner holds position for a
         second while the yaw changes, which is what keeps the walk animation
         pointing along the direction of travel. -->
    <actor name="target">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0</time><pose>3 -2 1.0 0 0 0</pose></waypoint>
          <waypoint><time>10</time><pose>7 -2 1.0 0 0 0</pose></waypoint>
          <waypoint><time>11</time><pose>7 -2 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>21</time><pose>7 2 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>22</time><pose>7 2 1.0 0 0 3.142</pose></waypoint>
          <waypoint><time>32</time><pose>3 2 1.0 0 0 3.142</pose></waypoint>
          <waypoint><time>33</time><pose>3 2 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>43</time><pose>3 -2 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>44</time><pose>3 -2 1.0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Two stationary people. They give the scene something to mistake the
         target for, which is the situation the DT split of EVT-Bench is built
         around, and they double as the fixed landmarks the recorded video
         needs to show that the robot is moving through the world. -->
    <actor name="distractor_a">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/stand.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="stand">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/stand.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="stand">
          <waypoint><time>0</time><pose>5 4 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>30</time><pose>5 4 1.0 0 0 -1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="distractor_b">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/stand.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="stand">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/stand.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="stand">
          <waypoint><time>0</time><pose>2 -4 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>30</time><pose>2 -4 1.0 0 0 1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <include>
      <uri>model://test_robot</uri>
      <pose>0 0 0.1 0 0 0</pose>
    </include>

  </world>
</sdf>
