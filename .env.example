# Copy to .env and adjust for the local machine. .env is never committed.

ROS_DOMAIN_ID=0

# Must match the host user so bind-mounted files stay writable.
USER_ID=1000
GROUP_ID=1000

# Directory mounted at /workspace/cache inside the container. It must contain
# the Hugging Face cache and the OmTrackVLA checkpoint directory.
MODEL_CACHE=/path/to/omtrackvla_storage/cache

# OmTrackVLA planner weights, as seen from inside the container.
HF_MODEL_DIR=/workspace/cache/OmTrackVLA-0.6B
